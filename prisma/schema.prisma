generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactSubmissionStatus {
  NEW
  REVIEWED
  RESPONDED
  ARCHIVED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id            String   @id @default("site")
  siteName      String
  shortName     String
  tagline       String
  description   String
  logo          String?
  favicon       String?
  showSiteName  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model HeroContent {
  id               String   @id @default("hero")
  eyebrow          String
  title            String
  subtitle         String
  primaryCtaText   String
  primaryCtaHref   String
  secondaryCtaText String
  secondaryCtaHref String
  image            String?
  updatedAt        DateTime @updatedAt
}

model AboutContent {
  id        String   @id @default("about")
  heroTitle String
  story     String
  mission   String
  vision    String
  approach  String
  image     String?
  updatedAt DateTime @updatedAt
}

model ContactInfo {
  id          String   @id @default("contact")
  officeTitle String
  address     String
  phone       String
  email       String
  hours       String
  mapEmbedUrl String?
  image       String?
  updatedAt   DateTime @updatedAt
}

model CompanyStat {
  id        String   @id @default(cuid())
  value     String
  label     String
  image     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Service {
  id        String   @id @default(cuid())
  title     String
  summary   String
  details   String
  icon      String
  image     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Industry {
  id        String   @id @default(cuid())
  name      String
  summary   String
  examples  String
  image     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model ProcessStep {
  id        String   @id @default(cuid())
  number    String
  title     String
  summary   String
  image     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Differentiator {
  id        String   @id @default(cuid())
  title     String
  summary   String
  image     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String
  company   String
  location  String
  image     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model ContactSubmission {
  id              String                  @id @default(cuid())
  name            String
  email           String
  phone           String?
  company         String?
  serviceInterest String?
  message         String
  status          ContactSubmissionStatus @default(NEW)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([createdAt])
  @@index([status])
}

// ─── Blog ────────────────────────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text
  category    String
  coverImage  String?
  author      String
  publishedAt DateTime @default(now())
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([published, publishedAt])
}

// ─── Team ────────────────────────────────────────────────────────────────────

model TeamMember {
  id             String   @id @default(cuid())
  name           String
  role           String
  bio            String
  qualifications String
  avatar         String?
  email          String?
  linkedin       String?
  order          Int      @default(0)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
}

// ─── FAQ ─────────────────────────────────────────────────────────────────────

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  image     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([category])
}

// ─── Awards & Certifications ─────────────────────────────────────────────────

model Award {
  id          String   @id @default(cuid())
  title       String
  issuer      String
  year        String
  description String?
  image       String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

// ─── Social Links ─────────────────────────────────────────────────────────────

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  icon      String   @default("Globe")
  image     String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}
